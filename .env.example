# ONECRM environment. Copy to .env.local. Never commit real secrets.

# Public base URL of the app (used for invite links and CSRF origin checks).
APP_URL=http://localhost:3000

# PostgreSQL connection string. If unset, the app uses an embedded PGlite database
# stored in .data/pglite (development and tests ONLY - not for production).
# DATABASE_URL=postgres://onecrm:onecrm@localhost:5432/onecrm

# Session lifetime in days.
SESSION_TTL_DAYS=14

# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts MFA seeds at rest.
# REQUIRED in production. Changing it makes existing MFA enrolments unusable.
# APP_ENCRYPTION_KEY=

# Outgoing email for password reset, verification and invitations, e.g.
# smtps://user:password@smtp.example.com:465
# Without it nothing is delivered; messages are only written to the server log.
# SMTP_URL=
# MAIL_FROM="ONECRM <no-reply@example.com>"
